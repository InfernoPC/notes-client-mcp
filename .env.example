# Copy this file to .env (in the project root) and fill in your real password.
# .env is gitignored - never commit the real file.
#
# SECURITY NOTE: this stores your Notes ID password in plaintext on disk.
# That is a deliberate, explicit trade-off (convenience over at-rest
# encryption) made for this project - it is not the tool's default
# recommendation. If NOTES_PASSWORD is unset, the Host Agent falls back to
# an interactive getpass() prompt instead, which never touches disk.
NOTES_PASSWORD=
